{
  "static": {
    "buildCommand": "npm run build",
    "buildDir": "catalog/out",
    "bucket": "majapi-ui-catalog-bucket-e4e2yfqxgt5r",
    "distributionId": "E37LTQOS5RFFKH",
    "region": "us-east-1",
    "url": "https://ui.majapi.com"
  },
  "ci": {
    "workbench": true,
    "checks": [
      "typecheck",
      "test:preferences",
      "test:data-table",
      "test:chat-quote",
      "test:chat-markdown",
      "test:ai-elements",
      "test:navigation",
      "test:workbench-patterns",
      "test:live-refresh",
      "test:toast",
      "test:sidebar",
      "test:tooltip",
      "test:popup-width",
      "test:check-table-actions",
      "test:release-plan",
      "lint",
      "check:standards",
      "build",
      "test:starter",
      "catalog:lint",
      "catalog:typecheck",
      "catalog:check-ui"
    ],
    "deploy": "workbench-ci"
  },
  "release": {
    "npmTokenSecret": "workbench-deploy/npm-token",
    "plan": "node scripts/release-plan.mjs",
    "validate": [
      "set -e; tmp=$(mktemp -d); npm pack --pack-destination \"$tmp\"; cp -r starters/next-app \"$tmp/starter\"; cd \"$tmp/starter\"; npm install --save-exact \"$tmp/majapisoftwares-ui-${version}.tgz\"; npm run lint; npm run typecheck; npm run check:ui; npm run build"
    ],
    "afterPublish": [
      "set -e; cd starters/next-app; i=0; until npm install --save-exact --prefer-online \"@majapisoftwares/ui@${version}\"; do i=$((i+1)); [ $i -ge 30 ] && exit 1; sleep 10; done",
      "npm run test:starter"
    ],
    "files": [
      "package.json",
      "package-lock.json",
      "starters/next-app/package.json",
      "starters/next-app/package-lock.json"
    ]
  }
}
