{
  "name": "@majapisoftwares/ui",
  "version": "5.0.0",
  "description": "Shared Workbench UI and UX standards based on shadcn/ui",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/majapisoftwares/workbench-ui.git"
  },
  "homepage": "https://ui.majapi.com",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "scripts/check-standards.mjs",
    "src",
    "components.json",
    "docs",
    "AGENTS.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    "./components/*": "./src/components/ui/*.tsx",
    "./patterns/*": "./src/patterns/*.tsx",
    "./templates/*": "./src/templates/*.tsx",
    "./styles.css": "./src/styles.css",
    "./lib/utils": "./src/lib/utils.ts"
  },
  "scripts": {
    "create:app": "node scripts/create-app.mjs",
    "test:starter": "node --test scripts/create-app.test.mjs",
    "dev": "vite --host 127.0.0.1 --port 4318 --strictPort",
    "build": "node scripts/write-release.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check src examples scripts *.json *.ts *.md docs/*.md",
    "check:standards": "node scripts/check-standards.mjs"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "1.61.0",
    "shadcn": "^4.22.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  }
}
